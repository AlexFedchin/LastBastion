{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Play Last Bastion",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": ["."],
      "preLaunchTask": "Prepare game",
      "outputCapture": "std",
      "console": "internalConsole"
    },
    {
      "name": "Play Last Bastion (windowed)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron.cmd"
      },
      "args": [".", "--windowed"],
      "preLaunchTask": "Prepare game",
      "outputCapture": "std",
      "console": "internalConsole"
    }
  ]
}
